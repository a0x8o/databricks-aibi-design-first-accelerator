class _UniqueKeyLoader(yaml.SafeLoader):
    pass


def _construct_unique_mapping(loader, node, deep=False):
    mapping = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in mapping:
            raise ValueError(f"Duplicate YAML key: {key}")
        mapping[key] = loader.construct_object(value_node, deep=deep)
    return mapping


_UniqueKeyLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
    _construct_unique_mapping,
)


def _load_yaml(path):
    with open(path, encoding="utf-8") as handle:
        value = yaml.load(handle, Loader=_UniqueKeyLoader)
    if not isinstance(value, dict):
        raise RuntimeError(f"Expected a YAML mapping at {path}")
    return value


def _atomic_write_yaml(path, value):
    temp_path = f"{path}.tmp.{os.getpid()}"
    with open(temp_path, "w", encoding="utf-8") as handle:
        yaml.safe_dump(value, handle, sort_keys=False)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp_path, path)


def _atomic_write_json(path, value):
    temp_path = f"{path}.tmp.{os.getpid()}"
    with open(temp_path, "w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp_path, path)


def _raw_sha256(path):
    with open(path, "rb") as handle:
        return hashlib.sha256(handle.read()).hexdigest()


def _canonical_sha256(value):
    payload = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def _merge_resolution_provenance(previous_rows, current_rows):
    """Merge runtime decisions without discarding parse-time provenance.

    The DDL notebook is a compatibility backstop.  It must not replace a
    parse-phase assumptions artifact just because the ERD is already valid;
    when it does repair a datatype, however, retain the earlier decision for
    the same column as provenance rather than silently losing it.
    """
    merged = []
    positions = {}
    for row in previous_rows if isinstance(previous_rows, list) else []:
        if not isinstance(row, dict):
            continue
        key = (row.get("table"), row.get("column"))
        if key in positions:
            continue
        positions[key] = len(merged)
        merged.append(dict(row))

    for row in current_rows:
        if not isinstance(row, dict):
            continue
        key = (row.get("table"), row.get("column"))
        runtime_row = dict(row)
        runtime_row["resolution_stage"] = "DDL_RUNTIME_BACKSTOP"
        if key not in positions:
            positions[key] = len(merged)
            merged.append(runtime_row)
            continue

        prior = merged[positions[key]]
        if prior == runtime_row:
            continue
        history = prior.get("provenance_history", [])
        if not isinstance(history, list):
            history = []
        prior_snapshot = dict(prior)
        prior_snapshot.pop("provenance_history", None)
        history.append(prior_snapshot)
        runtime_row["provenance_history"] = history
        merged[positions[key]] = runtime_row
    return merged


def _runtime_assumptions(existing, datatype_resolutions):
    """Build assumptions only after the runtime actually repaired datatypes."""
    prior = existing if isinstance(existing, dict) else {}
    assumptions = dict(prior)
    assumptions.update({
        "artifact_type": "schema_assumptions",
        "contract_version": 1,
        "policy_id": DATATYPE_RESOLUTION_POLICY_ID,
        "scope": "GREENFIELD_SYNTHETIC_GENERATED_TARGET_ONLY",
        "run_id": run_id,
        "asset_suffix": ASSET_SUFFIX,
        "catalog": CATALOG,
        "schema": SCHEMA,
        "eligible": datatype_resolution_eligible,
        "status": "PASS",
        "erd_parsed_path": ERD_PARSED_PATH,
        "erd_input_sha256": erd_parsed_input_sha256,
        "erd_output_sha256": _raw_sha256(ERD_PARSED_PATH),
        "unresolved_datatypes": [],
        "runtime_backstop_applied": True,
    })
    merged = _merge_resolution_provenance(
        prior.get("resolutions", []), datatype_resolutions
    )
    assumptions["resolution_count"] = len(merged)
    assumptions["resolutions"] = merged
    return assumptions


def _authenticate_existing_assumptions(assumptions):
    """Authenticate parse-time assumptions before consuming a strict ERD."""
    if not isinstance(assumptions, dict):
        raise RuntimeError(
            "SCHEMA_CONTRACT_ERROR: schema_assumptions.yaml must be a mapping"
        )
    required = {
        "run_id": run_id,
        "catalog": CATALOG,
        "schema": SCHEMA,
        "asset_suffix": ASSET_SUFFIX,
        "policy_id": DATATYPE_RESOLUTION_POLICY_ID,
        "status": "PASS",
    }
    for field, expected in required.items():
        if assumptions.get(field) != expected:
            raise RuntimeError(
                f"SCHEMA_CONTRACT_ERROR: schema_assumptions.yaml {field}="
                f"{assumptions.get(field)!r}, expected {expected!r}"
            )
    unresolved = assumptions.get("unresolved_datatypes")
    if unresolved != []:
        raise RuntimeError(
            "SCHEMA_CONTRACT_ERROR: schema_assumptions.yaml has unresolved datatypes"
        )
    expected_erd_hash = assumptions.get("erd_output_sha256")
    if not isinstance(expected_erd_hash, str) or expected_erd_hash != _raw_sha256(
        ERD_PARSED_PATH
    ):
        raise RuntimeError(
            "SCHEMA_CONTRACT_ERROR: schema_assumptions.yaml erd_output_sha256 "
            "does not authenticate the current erd_parsed.yaml"
        )


def _quote_identifier(value):
    if not isinstance(value, str) or not value or "`" in value:
        raise RuntimeError(f"Unsafe or empty SQL identifier: {value!r}")
    return f"`{value}`"


def _fqn(catalog, schema, table):
    return ".".join(_quote_identifier(part) for part in (catalog, schema, table))


def validate_uc_target_names(catalog, schema, tables, asset_suffix):
    """Validate all object-name components before any catalog mutation; never rename here."""
    def validate(value, label):
        if (not isinstance(value, str) or not value or len(value) > 255
                or any(c in '. /`' or ord(c) < 32 or ord(c) == 127 for c in value)):
            raise RuntimeError(
                f"GENERATED_IDENTIFIER_ERROR: {label}={value!r} is not a valid single UC "
                "object-name component. Resolve source labels to target names in the parse "
                "contract before DDL; quoting a dotted name does not make it valid."
            )
    validate(catalog, 'catalog')
    validate(schema, 'schema')
    if not isinstance(asset_suffix, str):
        raise RuntimeError('GENERATED_IDENTIFIER_ERROR: asset suffix must be text')
    seen = set()
    for table in tables:
        name = table.get('name')
        validate(name, 'logical table name')
        deployed = name + asset_suffix
        validate(deployed, 'deployed table name')
        if deployed.lower() in seen:
            raise RuntimeError(f'GENERATED_IDENTIFIER_ERROR: case-insensitive target collision: {deployed}')
        seen.add(deployed.lower())


_SIMPLE_TYPE_ALIASES = {"integer": "int", "long": "bigint"}
_SIMPLE_TYPES = {
    "bigint", "int", "smallint", "tinyint", "float", "double",
    "string", "boolean", "date", "timestamp", "timestamp_ntz", "binary",
}


def canonicalize_datatype(value):
    """Normalize syntax and expand documented Databricks DECIMAL defaults."""
    if not isinstance(value, str) or not value.strip():
        raise ValueError("datatype is empty")
    compact = re.sub(r"\s+", "", value).lower()
    compact = _SIMPLE_TYPE_ALIASES.get(compact, compact)
    if compact in _SIMPLE_TYPES:
        return compact

    decimal_match = re.fullmatch(
        r"(decimal|dec|numeric)(?:\((\d+)(?:,(\d+))?\))?", compact
    )
    if decimal_match:
        precision = int(decimal_match.group(2) or 10)
        scale = int(decimal_match.group(3) or 0)
        if not 1 <= precision <= 38:
            raise ValueError(f"decimal precision {precision} is outside 1..38")
        if not 0 <= scale <= precision:
            raise ValueError(f"decimal scale {scale} is outside 0..{precision}")
        return f"decimal({precision},{scale})"
    if re.match(r"^(decimal|dec|numeric)\b", compact):
        raise ValueError(f"decimal/numeric value {value!r} is malformed or truncated")

    length_match = re.fullmatch(r"(varchar|char|nvarchar)\((\d+)\)", compact)
    if length_match:
        length = int(length_match.group(2))
        if length < 1:
            raise ValueError("character length must be positive")
        return f"{length_match.group(1)}({length})"
    if re.match(r"^(varchar|char|nvarchar)\b", compact):
        raise ValueError("varchar/char/nvarchar must include a complete positive length")
    raise ValueError(f"unsupported or malformed datatype {value!r}")


_SEMANTIC_TOKENS = {
    "MONETARY": {
        "amt", "amount", "allowed", "balance", "billed", "charge", "coinsurance",
        "copay", "cost", "deduct", "expense", "fee", "net", "paid", "payment",
        "premium", "price", "revenue",
    },
    "RATIO": {"factor", "pct", "percent", "percentage", "rate", "ratio"},
    "MEASUREMENT": {
        "dose", "dosage", "duration", "height", "measurement", "qty", "quantity",
        "volume", "weight",
    },
    "COUNT": {"count", "cnt", "nbr", "num", "number", "rank", "seq", "sequence"},
}
_DECIMAL_DEFAULTS = {
    "MONETARY": (38, 4),
    "RATIO": (38, 6),
    "MEASUREMENT": (38, 4),
    "COUNT": (38, 0),
    "GENERIC": (38, 18),
}
_TYPE_SYNONYMS = {
    "bit": "boolean", "bool": "boolean", "byte": "tinyint",
    "datetime": "timestamp", "datetime2": "timestamp", "int16": "smallint",
    "int32": "int", "int64": "bigint", "json": "string", "real": "float",
    "short": "smallint", "text": "string", "uuid": "string", "xml": "string",
}


def _semantic_family(column_name):
    tokens = set(re.findall(r"[a-z0-9]+", str(column_name or "").lower()))
    for family in ("MONETARY", "RATIO", "MEASUREMENT", "COUNT"):
        if tokens & _SEMANTIC_TOKENS[family]:
            return family
    return "GENERIC"


def _strict_decimal_parts(value):
    if not isinstance(value, str):
        return None
    match = re.fullmatch(
        r"\s*(?:decimal|dec|numeric)\s*\(\s*(\d+)\s*,\s*(\d+)\s*\)\s*",
        value,
        re.IGNORECASE,
    )
    if not match:
        return None
    precision, scale = int(match.group(1)), int(match.group(2))
    if 1 <= precision <= 38 and 0 <= scale <= precision:
        return precision, scale
    return None


def _strict_majority(values):
    if not values:
        return None
    counts = {value: values.count(value) for value in set(values)}
    scale, count = sorted(counts.items(), key=lambda item: (-item[1], item[0]))[0]
    return scale if count * 2 > len(values) else None


def _peer_scale(tables, table_name, column_name, family):
    same_table = []
    global_values = []
    for table in tables:
        for column in table.get("observed", {}).get("columns", []):
            if table.get("name") == table_name and column.get("name") == column_name:
                continue
            if _semantic_family(column.get("name")) != family:
                continue
            parts = _strict_decimal_parts(column.get("datatype"))
            if parts is None:
                continue
            global_values.append(parts[1])
            if table.get("name") == table_name:
                same_table.append(parts[1])
    scale = _strict_majority(same_table)
    if scale is not None:
        return scale, "SAME_TABLE_SEMANTIC_PEER_MODE", [f"peer_scales={same_table!r}"]
    scale = _strict_majority(global_values)
    if scale is not None:
        return scale, "GLOBAL_SEMANTIC_PEER_MODE", [f"peer_scales={global_values!r}"]
    return None, None, []


def _fallback_from_column_name(column_name):
    name = str(column_name or "").lower()
    tokens = set(re.findall(r"[a-z0-9]+", name))
    family = _semantic_family(name)
    if family != "GENERIC":
        precision, scale = _DECIMAL_DEFAULTS[family]
        return f"decimal({precision},{scale})", "SEMANTIC_NUMERIC_POLICY", [f"family={family}"]
    if tokens & {"date", "dob"} or name.endswith("_dt"):
        return "date", "SEMANTIC_DATE_POLICY", ["date-like column name"]
    if tokens & {"timestamp", "datetime", "dttm"} or name.endswith(("_ts", "_at")):
        return "timestamp", "SEMANTIC_TIMESTAMP_POLICY", ["timestamp-like column name"]
    if name.startswith(("is_", "has_")) or tokens & {"bool", "boolean", "flag", "ind", "indicator"}:
        return "boolean", "SEMANTIC_BOOLEAN_POLICY", ["boolean-like column name"]
    return "string", "SAFE_STRING_FALLBACK", ["no reliable numeric or temporal semantic evidence"]


def _resolve_greenfield_synthetic_datatypes(erd_document):
    """Resolve datatype-only defects and return ordered provenance rows."""
    tables = erd_document.get("tables")
    if not isinstance(tables, list) or not tables:
        raise RuntimeError("ERD_EXTRACTION_ERROR: erd_parsed.yaml has no tables")
    decisions = []
    for table in tables:
        if not isinstance(table, dict):
            raise RuntimeError(
                "ERD_EXTRACTION_ERROR: erd_parsed.yaml contains a non-mapping table"
            )
        table_name = table.get("name", "unknown")
        observed = table.get("observed")
        columns = observed.get("columns") if isinstance(observed, dict) else None
        if not isinstance(columns, list) or not columns:
            raise RuntimeError(
                f"ERD_EXTRACTION_ERROR: {table_name} has no observed columns"
            )
        for column in columns:
            if not isinstance(column, dict):
                raise RuntimeError(
                    f"ERD_EXTRACTION_ERROR: {table_name} contains a non-mapping column"
                )
            column_name = column.get("name", "unknown")
            raw = column.get("datatype")
            raw_text = raw.strip() if isinstance(raw, str) else ""
            try:
                resolved = canonicalize_datatype(raw_text)
                compact = re.sub(r"\s+", "", raw_text).lower()
                if re.fullmatch(r"(?:decimal|dec|numeric)(?:\(\d+\))?", compact):
                    decisions.append({
                        "table": table_name, "column": column_name,
                        "raw_datatype": raw, "resolved_datatype": resolved,
                        "resolution_source": "DATABRICKS_DEFAULT_EXPANSION",
                        "confidence": "HIGH", "semantic_family": _semantic_family(column_name),
                        "inference": False, "observed": True,
                        "evidence": ["documented DECIMAL default precision=10 and scale=0"],
                    })
                column["datatype"] = resolved
                continue
            except ValueError:
                pass

            compact = re.sub(r"\s+", "", raw_text).lower()
            family = _semantic_family(column_name)
            confidence = "MEDIUM"
            if re.match(r"^(decimal|dec|numeric|number)\b", compact):
                numbers = [int(value) for value in re.findall(r"\d+", compact)]
                observed_precision = numbers[0] if numbers else None
                observed_scale = numbers[1] if len(numbers) > 1 else None
                if observed_scale is not None:
                    scale = min(max(observed_scale, 0), 37)
                    precision = min(max(observed_precision or 38, scale + 1), 38)
                    source = "DECIMAL_SYNTAX_RECOVERY"
                    evidence = [f"visible_precision={observed_precision}", f"visible_scale={observed_scale}"]
                    confidence = "HIGH"
                else:
                    scale, source, evidence = _peer_scale(
                        tables, table_name, column_name, family
                    )
                    if scale is None:
                        _, scale = _DECIMAL_DEFAULTS[family]
                        source = "SEMANTIC_DECIMAL_POLICY"
                        evidence = [f"family={family}"]
                    precision = observed_precision if observed_precision and observed_precision > 0 else _DECIMAL_DEFAULTS[family][0]
                    precision = min(max(precision, scale + (1 if scale else 0)), 38)
                    scale = min(scale, precision)
                resolved = f"decimal({precision},{scale})"
            elif re.match(r"^(varchar|char|nvarchar)\b", compact):
                resolved = "string"
                source = "NON_TRUNCATING_STRING_FALLBACK"
                evidence = ["character length was unavailable or invalid"]
                confidence = "HIGH"
            elif compact in _TYPE_SYNONYMS:
                resolved = _TYPE_SYNONYMS[compact]
                source = "DATABRICKS_TYPE_SYNONYM"
                evidence = [f"source_type={raw_text!r}"]
                confidence = "HIGH"
            else:
                resolved, source, evidence = _fallback_from_column_name(column_name)
                confidence = "LOW"
            column["datatype"] = resolved
            decisions.append({
                "table": table_name, "column": column_name,
                "raw_datatype": raw, "resolved_datatype": resolved,
                "resolution_source": source, "confidence": confidence,
                "semantic_family": family, "inference": True, "observed": False,
                "evidence": evidence,
            })
    return decisions


def _datatype_resolution_is_eligible(run_context_document):
    data_source_value = run_context_document.get("data_source", {})
    greenfield_value = data_source_value.get("greenfield", {})
    return (
        data_source_value.get("type") in {"erd", "erd_and_live_schema"}
        and greenfield_value.get("enabled") is True
        and greenfield_value.get("synthetic_data") is True
    )


def _synchronize_erd_projection(erd_document, table_spec):
    """Regenerate derived type fields from the resolved ERD contract.

    Governed datatype resolution, when eligible, occurs before this function.
    Every replacement here is the exact complete value in the resolved ERD.
    Structural drift remains a hard failure.
    """
    erd_tables = erd_document.get("tables")
    spec_tables = table_spec.get("tables")
    if not isinstance(erd_tables, list) or not erd_tables:
        raise RuntimeError("ERD_EXTRACTION_ERROR: erd_parsed.yaml has no tables")
    if not isinstance(spec_tables, list) or not spec_tables:
        raise RuntimeError("SCHEMA_CONTRACT_ERROR: table_spec.yaml has no tables")

    erd_names = [table.get("name") for table in erd_tables]
    spec_names = [table.get("name") for table in spec_tables]
    if len(erd_names) != len(set(erd_names)):
        raise RuntimeError("ERD_EXTRACTION_ERROR: duplicate table names in erd_parsed.yaml")
    if len(spec_names) != len(set(spec_names)):
        raise RuntimeError("SCHEMA_CONTRACT_ERROR: duplicate table names in table_spec.yaml")
    if erd_names != spec_names:
        raise RuntimeError(
            f"SCHEMA_CONTRACT_ERROR: table inventory/order mismatch: "
            f"ERD={erd_names!r}, table_spec={spec_names!r}"
        )

    updates = []
    for erd_table, spec_table in zip(erd_tables, spec_tables):
        table_name = erd_table.get("name")
        erd_columns = erd_table.get("observed", {}).get("columns")
        spec_columns = spec_table.get("columns")
        if not isinstance(erd_columns, list) or not erd_columns:
            raise RuntimeError(
                f"ERD_EXTRACTION_ERROR: {table_name} has no observed columns"
            )
        if not isinstance(spec_columns, list) or not spec_columns:
            raise RuntimeError(
                f"SCHEMA_CONTRACT_ERROR: {table_name} has no table-spec columns"
            )
        erd_column_names = [column.get("name") for column in erd_columns]
        spec_column_names = [column.get("name") for column in spec_columns]
        if len(erd_column_names) != len(set(erd_column_names)):
            raise RuntimeError(
                f"ERD_EXTRACTION_ERROR: duplicate column names in {table_name}"
            )
        if len(spec_column_names) != len(set(spec_column_names)):
            raise RuntimeError(
                f"SCHEMA_CONTRACT_ERROR: duplicate table-spec columns in {table_name}"
            )
        if erd_column_names != spec_column_names:
            raise RuntimeError(
                f"SCHEMA_CONTRACT_ERROR: {table_name} column inventory/order mismatch: "
                f"ERD={erd_column_names!r}, table_spec={spec_column_names!r}"
            )
        canonical_erd_types = []
        for erd_column in erd_columns:
            column_name = erd_column.get("name")
            erd_type = erd_column.get("datatype")
            try:
                canonical_erd_types.append(canonicalize_datatype(erd_type))
            except ValueError as exc:
                raise RuntimeError(
                    f"ERD_EXTRACTION_ERROR: {table_name}.{column_name}: {exc}; "
                    "reject any cached parse and perform targeted authoritative reparse"
                ) from exc

        for erd_column, spec_column, canonical_erd_type in zip(
            erd_columns, spec_columns, canonical_erd_types
        ):
            column_name = erd_column.get("name")
            erd_type = erd_column.get("datatype")
            spec_type = spec_column.get("type")
            try:
                canonical_spec_type = canonicalize_datatype(spec_type)
                reason = "DATATYPE_MISMATCH"
            except ValueError:
                canonical_spec_type = None
                reason = "INCOMPLETE_OR_INVALID_DERIVED_DATATYPE"
            if canonical_erd_type != canonical_spec_type:
                updates.append({
                    "table": table_name,
                    "column": column_name,
                    "previous_table_spec_datatype": spec_type,
                    "authoritative_erd_datatype": erd_type,
                    "reason": reason,
                })
                spec_column["type"] = erd_type
    return updates


