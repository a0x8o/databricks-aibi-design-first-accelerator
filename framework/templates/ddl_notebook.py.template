    "handoff.run_id": (step_handoff.get("run_id"), run_id),
    "handoff.catalog": (step_handoff.get("catalog"), TARGET_CATALOG),
    "handoff.schema": (step_handoff.get("schema"), TARGET_SCHEMA),
    "handoff.asset_suffix": (step_handoff.get("asset_suffix"), ASSET_SUFFIX),
    "handoff.output_folder": (step_handoff.get("output_folder"), OUTPUT_FOLDER),
}
for field, (actual, expected) in parity_checks.items():
    if actual != expected:
        raise RuntimeError(f"DDL_INPUT_AUTHORITY_ERROR: {field}={actual!r}, expected {expected!r}")
if greenfield.get("enabled") is not True:
    raise RuntimeError("DDL_INPUT_AUTHORITY_ERROR: generated DDL requires greenfield.enabled=true")

# GATE 4.0 is enforced inside the deterministic runtime so an agent cannot
# accidentally skip it. Datatype-only defects may be resolved only for an
# ERD-driven greenfield synthetic target. The resolved ERD and every decision
# are persisted before the exact table-spec projection is regenerated.
table_spec_input_sha256 = _raw_sha256(SPEC_PATH)
erd_parsed_input_sha256 = _raw_sha256(ERD_PARSED_PATH)
datatype_resolution_eligible = _datatype_resolution_is_eligible(run_context)
datatype_resolutions = []
try:
    if datatype_resolution_eligible:
        datatype_resolutions = _resolve_greenfield_synthetic_datatypes(erd_document)
        if datatype_resolutions:
            _atomic_write_yaml(ERD_PARSED_PATH, erd_document)
            erd_document = _load_yaml(ERD_PARSED_PATH)
            convergence_resolutions = _resolve_greenfield_synthetic_datatypes(erd_document)
            if convergence_resolutions:
                raise RuntimeError(
                    "ERD_EXTRACTION_ERROR: datatype resolution did not converge"
                )

    # schema_assumptions.yaml is normally produced by parse_erd.  Preserve
    # its exact bytes on the strict-valid path; the runtime backstop may
    # update it only when it actually repairs a datatype defect.
    if datatype_resolutions:
        existing_assumptions = (
            _load_yaml(SCHEMA_ASSUMPTIONS_PATH)
            if os.path.exists(SCHEMA_ASSUMPTIONS_PATH) else None
        )
        assumptions = _runtime_assumptions(
            existing_assumptions, datatype_resolutions
        )
        _atomic_write_yaml(SCHEMA_ASSUMPTIONS_PATH, assumptions)
    else:
        if not os.path.exists(SCHEMA_ASSUMPTIONS_PATH):
            raise RuntimeError(
                "SCHEMA_CONTRACT_ERROR: schema_assumptions.yaml is required "
                "for a strict-valid ERD"
            )
        existing_assumptions = _load_yaml(SCHEMA_ASSUMPTIONS_PATH)
        _authenticate_existing_assumptions(existing_assumptions)

    projection_updates = _synchronize_erd_projection(erd_document, spec)
    if projection_updates:
        _atomic_write_yaml(SPEC_PATH, spec)
        spec = _load_yaml(SPEC_PATH)
        remaining_updates = _synchronize_erd_projection(erd_document, spec)
        if remaining_updates:
            raise RuntimeError(
                "SCHEMA_CONTRACT_ERROR: deterministic table-spec regeneration did not converge"
            )
    validate_uc_target_names(CATALOG, SCHEMA, spec.get('tables', []), ASSET_SUFFIX)
    preflight = {
        "artifact_type": "ddl_preflight",
        "contract_version": 1,
        "run_id": run_id,
        "asset_suffix": ASSET_SUFFIX,
        "catalog": CATALOG,
        "schema": SCHEMA,
        "status": "PASS",
        "failure_code": None,
        "catalog_mutation_started": False,
        "erd_parsed_path": ERD_PARSED_PATH,
        "erd_parsed_input_sha256": erd_parsed_input_sha256,
        "erd_parsed_output_sha256": _raw_sha256(ERD_PARSED_PATH),
        "schema_assumptions_path": SCHEMA_ASSUMPTIONS_PATH,
        "schema_assumptions_sha256": (
            _raw_sha256(SCHEMA_ASSUMPTIONS_PATH)
            if os.path.exists(SCHEMA_ASSUMPTIONS_PATH) else None
        ),
        "datatype_resolution_policy_id": DATATYPE_RESOLUTION_POLICY_ID,
        "datatype_resolution_eligible": datatype_resolution_eligible,
        "datatype_resolutions": datatype_resolutions,
        "parse_checkpoint_refresh_required": bool(datatype_resolutions),
        "table_spec_path": SPEC_PATH,
        "table_spec_input_sha256": table_spec_input_sha256,
        "table_spec_output_sha256": _raw_sha256(SPEC_PATH),
        "action": (
            "RESOLVED_ERD_DATATYPES_AND_REGENERATED_TABLE_SPEC"
            if datatype_resolutions and projection_updates
            else "RESOLVED_ERD_DATATYPES"
            if datatype_resolutions
            else "REGENERATED_TABLE_SPEC_TYPES_FROM_VALIDATED_ERD"
            if projection_updates
            else "NO_CHANGE"
        ),
        "type_regenerations": projection_updates,
    }
    _atomic_write_yaml(DDL_PREFLIGHT_PATH, preflight)
except RuntimeError as exc:
    message = str(exc)
    failure_code = (
        "GENERATED_IDENTIFIER_ERROR"
        if message.startswith("GENERATED_IDENTIFIER_ERROR:")
        else
        "ERD_EXTRACTION_ERROR"
        if message.startswith("ERD_EXTRACTION_ERROR:")
        else "SCHEMA_CONTRACT_ERROR"
    )
    preflight = {
        "artifact_type": "ddl_preflight",
        "contract_version": 1,
        "run_id": run_id,
        "asset_suffix": ASSET_SUFFIX,
        "catalog": CATALOG,
        "schema": SCHEMA,
        "status": "FAIL",
        "failure_code": failure_code,
        "catalog_mutation_started": False,
        "erd_parsed_path": ERD_PARSED_PATH,
        "erd_parsed_input_sha256": erd_parsed_input_sha256,
        "erd_parsed_output_sha256": _raw_sha256(ERD_PARSED_PATH),
        "schema_assumptions_path": SCHEMA_ASSUMPTIONS_PATH,
        "schema_assumptions_sha256": (
            _raw_sha256(SCHEMA_ASSUMPTIONS_PATH)
            if os.path.exists(SCHEMA_ASSUMPTIONS_PATH) else None
        ),
        "datatype_resolution_policy_id": DATATYPE_RESOLUTION_POLICY_ID,
        "datatype_resolution_eligible": datatype_resolution_eligible,
        "datatype_resolutions": datatype_resolutions,
        "parse_checkpoint_refresh_required": bool(datatype_resolutions),
        "table_spec_path": SPEC_PATH,
        "table_spec_input_sha256": table_spec_input_sha256,
        "table_spec_output_sha256": _raw_sha256(SPEC_PATH),
        "action": "HALT_PRE_MUTATION",
        "type_regenerations": [],
        "error": message,
    }
    _atomic_write_yaml(DDL_PREFLIGHT_PATH, preflight)
    raise

TABLES = spec.get("tables")
if not isinstance(TABLES, list) or not TABLES:
    raise RuntimeError("table_spec.yaml has no tables")

seen_tables = set()
for table in TABLES:
    table_name = table.get("name")
    columns = table.get("columns")
    if not isinstance(table_name, str) or not table_name:
        raise RuntimeError("Table missing a non-empty name")
    if table_name in seen_tables:
        raise RuntimeError(f"Duplicate table name: {table_name}")
    seen_tables.add(table_name)
    if not isinstance(columns, list) or not columns:
        raise RuntimeError(f"Table {table_name} has no columns")
    seen_columns = set()
    for column in columns:
        column_name = column.get("name")
        datatype = column.get("type")
        if not isinstance(column_name, str) or not column_name:
            raise RuntimeError(f"Column missing a non-empty name in {table_name}")
        if column_name in seen_columns:
            raise RuntimeError(f"Duplicate column {table_name}.{column_name}")
        seen_columns.add(column_name)
        try:
            canonicalize_datatype(datatype)
        except ValueError as exc:
            raise RuntimeError(
                f"SCHEMA_CONTRACT_ERROR: {table_name}.{column_name}: received "
                f"{datatype!r}: {exc}; governed preflight resolution did not produce a valid type"
            ) from exc

spark.sql(f"CREATE SCHEMA IF NOT EXISTS {_quote_identifier(CATALOG)}.{_quote_identifier(SCHEMA)}")
print(
    f"Gates 1-2 and 4.0 PASSED: {len(TABLES)} tables; "
    f"table-spec type regenerations={len(projection_updates)}"
)

# COMMAND ----------

# DBTITLE 1,Compile and Execute DDL
DDL_BY_TABLE = {}
PREEXISTING = {}
for table in TABLES:
    deployed_name = f"{table['name']}{ASSET_SUFFIX}"
    full_name = _fqn(CATALOG, SCHEMA, deployed_name)
    try:
        spark.sql(f"DESCRIBE TABLE {full_name}").collect()
        PREEXISTING[deployed_name] = True
    except Exception:
        PREEXISTING[deployed_name] = False

    column_definitions = []
    for column in table["columns"]:
        nullable = "" if column.get("nullable", True) else " NOT NULL"
        column_definitions.append(
            f"  {_quote_identifier(column['name'])} {column['type'].strip()}{nullable}"
        )
    comment = str(table.get("comment", "")).replace("'", "''")
    ddl = (
        f"CREATE TABLE IF NOT EXISTS {full_name} (\n"
        + ",\n".join(column_definitions)
        + f"\n) USING DELTA COMMENT '{comment}'"
    )
    DDL_BY_TABLE[deployed_name] = ddl

for deployed_name, ddl in DDL_BY_TABLE.items():
    spark.sql(ddl)
    print(f"Created or confirmed: {CATALOG}.{SCHEMA}.{deployed_name}")

print(f"Executed {len(DDL_BY_TABLE)} compiler-generated CREATE statements")

# COMMAND ----------

# DBTITLE 1,Exact Schema Reconciliation (GATE 4.1 + 4.2)
def _read_deployed_schema(deployed_name):
    rows = spark.sql(f"DESCRIBE TABLE {_fqn(CATALOG, SCHEMA, deployed_name)}").collect()
    schema_rows = []
    for row in rows:
        column_name = str(row["col_name"]).strip()
        datatype = str(row["data_type"]).strip()
        if not column_name or column_name.startswith("#"):
            break
        schema_rows.append({
            "column": column_name,
            "datatype": datatype,
            "canonical_datatype": canonicalize_datatype(datatype),
        })
    return schema_rows


def _expected_schema(table):
    return [
        {
            "column": column["name"],
            "datatype": column["type"].strip(),
            "canonical_datatype": canonicalize_datatype(column["type"]),
        }
        for column in table["columns"]
    ]


def _schema_differences(expected, observed):
    differences = []
    expected_names = [item["column"] for item in expected]
    observed_names = [item["column"] for item in observed]
    if expected_names != observed_names:
        differences.append({
            "mismatch_kind": "STRUCTURAL",
            "expected_columns": expected_names,
            "observed_columns": observed_names,
        })
        return differences
    for expected_column, observed_column in zip(expected, observed):
        if expected_column["canonical_datatype"] != observed_column["canonical_datatype"]:
            differences.append({
                "mismatch_kind": "DATATYPE",
                "column": expected_column["column"],
                "expected_datatype": expected_column["datatype"],
                "observed_datatype": observed_column["datatype"],
            })
    return differences


prior_attempts = {}
if os.path.exists(RECONCILIATION_PATH):
    prior = _load_yaml(RECONCILIATION_PATH)
    if prior.get("run_id") == run_id and prior.get("asset_suffix") == ASSET_SUFFIX:
        for attempt in prior.get("attempts", []):
            table_fqn = attempt.get("table_fqn")
            if attempt.get("action") == "DROP_RECREATE_FROM_TABLE_SPEC":
                prior_attempts[table_fqn] = prior_attempts.get(table_fqn, 0) + 1

attempts = []
unresolved = []
expected_inventory = []
observed_inventory = []

for table in TABLES:
    deployed_name = f"{table['name']}{ASSET_SUFFIX}"
    plain_fqn = f"{CATALOG}.{SCHEMA}.{deployed_name}"
    expected = _expected_schema(table)
    observed = _read_deployed_schema(deployed_name)
    differences = _schema_differences(expected, observed)

    if differences:
        try:
            row_count = spark.sql(
                f"SELECT COUNT(*) AS row_count FROM {_fqn(CATALOG, SCHEMA, deployed_name)}"
            ).collect()[0]["row_count"]
            row_count = int(row_count)
        except Exception:
            row_count = None

        eligible = (
            row_count == 0
            and prior_attempts.get(plain_fqn, 0) == 0
            and greenfield.get("enabled") is True
        )
        attempt = {
            "table_fqn": plain_fqn,
            "mismatch_kind": "DATATYPE" if any(
                item["mismatch_kind"] == "DATATYPE" for item in differences
            ) else "STRUCTURAL",
            "expected_schema": expected,
            "observed_schema": observed,
            "canonical_comparison": "MISMATCH",
            "ownership": "CURRENT_VERSION_GENERATED_TARGET",
            "row_count_before": row_count,
            "attempt": prior_attempts.get(plain_fqn, 0),
        }

        if eligible:
            spark.sql(f"DROP TABLE {_fqn(CATALOG, SCHEMA, deployed_name)}")
            spark.sql(DDL_BY_TABLE[deployed_name])
            repaired_observed = _read_deployed_schema(deployed_name)
            repaired_differences = _schema_differences(expected, repaired_observed)
            attempt.update({
                "action": "DROP_RECREATE_FROM_TABLE_SPEC",
                "attempt": 1,
                "post_repair_schema": repaired_observed,
                "status": "PASS" if not repaired_differences else "FAIL",
                "error_code": None if not repaired_differences else "DATATYPE_MISMATCH_UNSAFE_TO_REPAIR",
            })
            attempts.append(attempt)
            observed = repaired_observed
            differences = repaired_differences
        else:
            attempt.update({
                "action": "HALT_NO_MUTATION",
                "post_repair_schema": [],
                "status": "FAIL",
                "error_code": (
                    "DATATYPE_MISMATCH_UNSAFE_TO_REPAIR"
                    if any(item["mismatch_kind"] == "DATATYPE" for item in differences)
                    else "SCHEMA_CONTRACT_ERROR"
                ),
            })
            attempts.append(attempt)

        for difference in differences:
            unresolved.append({"table_fqn": plain_fqn, **difference})

    expected_inventory.append({"table_fqn": plain_fqn, "schema": expected})
    observed_inventory.append({"table_fqn": plain_fqn, "schema": observed})

status = "PASS" if not unresolved else "FAIL"
failure_code = None
if status == "FAIL":
    failure_code = (
        "DATATYPE_MISMATCH_UNSAFE_TO_REPAIR"
        if any(item.get("mismatch_kind") == "DATATYPE" for item in unresolved)
        else "SCHEMA_CONTRACT_ERROR"
    )
reconciliation = {
    "artifact_type": "schema_reconciliation",
    "contract_version": 1,
    "run_id": run_id,
    "asset_suffix": ASSET_SUFFIX,
    "catalog": CATALOG,
    "schema": SCHEMA,
    "output_folder": OUTPUT_FOLDER,
    "producer_step": "create_data_layer",
    "producer_phase": "reconcile_schema",
    "policy_id": POLICY_ID,
    "schema_assumptions_path": SCHEMA_ASSUMPTIONS_PATH,
    "schema_assumptions_sha256": _raw_sha256(SCHEMA_ASSUMPTIONS_PATH),
    "datatype_resolution_policy_id": DATATYPE_RESOLUTION_POLICY_ID,
    "datatype_resolution_count": len(datatype_resolutions),
    "status": status,
    "failure_code": failure_code,
    "table_spec_path": SPEC_PATH,
    "table_spec_sha256": _raw_sha256(SPEC_PATH),
    "expected_schema_sha256": _canonical_sha256(expected_inventory),
    "observed_schema_sha256": _canonical_sha256(observed_inventory),
    "canonical_comparison": "MATCH" if status == "PASS" else "MISMATCH",
    "expected_schema_inventory": expected_inventory,
    "observed_schema_inventory": observed_inventory,
    "datatype_policy": "EMPTY_CURRENT_VERSION_TABLE_RECREATE_ONLY",
    "tables_expected": len(TABLES),
    "tables_checked": len(observed_inventory),
    "preexisting_tables": sorted(name for name, existed in PREEXISTING.items() if existed),
    "created_this_run": sorted(name for name, existed in PREEXISTING.items() if not existed),
    "attempts": attempts,
    "unresolved_mismatches": unresolved,
}
_atomic_write_yaml(RECONCILIATION_PATH, reconciliation)

if status != "PASS":
    print(f"GATE 4.2 FAILED: {len(unresolved)} unresolved schema mismatch(es)")
    raise RuntimeError(
        f"{failure_code}: persisted schema_reconciliation.yaml; "
        "synthetic data generation is blocked"
    )

print(f"GATE 4.1 PASSED: all {len(TABLES)} exact expected tables resolve")
print("GATE 4.2 PASSED: deployed column names and datatypes exactly reconcile")
print(f"Reconciliation evidence: {RECONCILIATION_PATH}")

# COMMAND ----------

# DBTITLE 1,Write DDL Manifest After Reconciliation PASS
source_hash = _raw_sha256(SPEC_PATH)
generated_hash = hashlib.sha256(
    "\n\n---\n\n".join(DDL_BY_TABLE[name] for name in sorted(DDL_BY_TABLE)).encode("utf-8")
).hexdigest()
reconciliation_hash = _raw_sha256(RECONCILIATION_PATH)

manifest = {
    "artifact_type": "ddl",
    "domain": "{{DOMAIN_NAME}}",
    "run_id": run_id,
    "asset_suffix": ASSET_SUFFIX,
    "validation_source": "catalog_describe",
    "source_hash": source_hash,
    "generated_hash": generated_hash,
    "readback_hash": reconciliation["observed_schema_sha256"],
    "schema_reconciliation_path": RECONCILIATION_PATH,
    "schema_reconciliation_sha256": reconciliation_hash,
    "ddl_preflight_path": DDL_PREFLIGHT_PATH,
    "ddl_preflight_sha256": _raw_sha256(DDL_PREFLIGHT_PATH),
    "schema_assumptions_path": SCHEMA_ASSUMPTIONS_PATH,
    "schema_assumptions_sha256": _raw_sha256(SCHEMA_ASSUMPTIONS_PATH),
    "datatype_resolution_policy_id": DATATYPE_RESOLUTION_POLICY_ID,
    "datatype_resolution_count": len(datatype_resolutions),
    "table_spec_projection_action": preflight["action"],
    "table_spec_type_regenerations": len(preflight["type_regenerations"]),
    "state_comparison": "match",
    "catalog": CATALOG,
    "schema": SCHEMA,
    "tables": [
        {
            "name": f"{table['name']}{ASSET_SUFFIX}",
            "fqn": f"{CATALOG}.{SCHEMA}.{table['name']}{ASSET_SUFFIX}",
            "column_count": len(table["columns"]),
            "comment": table.get("comment", ""),
        }
        for table in TABLES
    ],
    "total_tables": len(TABLES),
    "total_tables_deployed": len(observed_inventory),
}
_atomic_write_json(MANIFEST_PATH, manifest)
print(f"DDL deployment complete: {len(TABLES)} tables, exact schema reconciliation PASS")
